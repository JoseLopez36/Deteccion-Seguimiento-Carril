<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lane_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="road_surface">
      <static>true</static>
      <pose>0 0 0.011 0 0 0</pose>
      <link name="road_link">
        <visual name="road_visual">
          <geometry>
            <box>
              <size>60 4 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
        <collision name="road_collision">
          <geometry>
            <box>
              <size>60 4 0.02</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="left_lane_marking">
      <static>true</static>
      <pose>0 0.9 0.025 0 0 0</pose>
      <link name="left_lane_marking_link">
        <visual name="left_lane_marking_visual">
          <geometry>
            <box>
              <size>60 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_lane_marking">
      <static>true</static>
      <pose>0 -0.9 0.025 0 0 0</pose>
      <link name="right_lane_marking_link">
        <visual name="right_lane_marking_visual">
          <geometry>
            <box>
              <size>60 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
